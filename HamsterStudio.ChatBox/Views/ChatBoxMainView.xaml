<UserControl x:Class="HamsterStudio.ChatBox.Views.ChatBoxMainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:HamsterStudio.ChatBox.ViewModels"
             xmlns:conv="clr-namespace:HamsterStudio.ChatBox.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900">
    <UserControl.Resources>
        <conv:Base64DataUrlToImageConverter x:Key="Base64ToImage" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- 工具栏 -->
            <RowDefinition Height="Auto" />   <!-- 连接设置 -->
            <RowDefinition Height="*" />      <!-- 消息列表 -->
            <RowDefinition Height="Auto" />   <!-- 状态栏 -->
            <RowDefinition Height="Auto" />   <!-- 输入区 -->
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,6">
            <Button DockPanel.Dock="Right" Content="停止" Command="{Binding StopCommand}"
                    Padding="10,4" Margin="6,0,0,0" />
            <Button DockPanel.Dock="Right" Content="清空" Command="{Binding ClearCommand}"
                    Padding="10,4" Margin="6,0,0,0" />
            <Button DockPanel.Dock="Right" Content="取消下载" Command="{Binding CancelPullCommand}"
                    Padding="10,4" Margin="6,0,0,0"
                    Visibility="{Binding IsPulling, Converter={StaticResource BoolToVis}}" />
            <Button DockPanel.Dock="Right" Content="下载模型" Command="{Binding PullModelCommand}"
                    Padding="10,4" Margin="6,0,0,0" />
            <Button DockPanel.Dock="Right" Content="刷新模型" Command="{Binding RefreshModelsCommand}"
                    Padding="10,4" Margin="6,0,0,0" />

            <TextBlock DockPanel.Dock="Left" Text="后端:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox DockPanel.Dock="Left" Width="110" VerticalAlignment="Center"
                      ItemsSource="{Binding ProviderKinds}"
                      SelectedItem="{Binding SelectedProvider}" />

            <TextBlock DockPanel.Dock="Left" Text="模型:" VerticalAlignment="Center" Margin="12,0,6,0" />
            <ComboBox VerticalAlignment="Center" Width="220"
                      ItemsSource="{Binding Models}"
                      IsEditable="True"
                      Text="{Binding SelectedModel, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>

        <!-- 连接设置 -->
        <Expander Grid.Row="1" Header="连接设置" Margin="0,0,0,6" IsExpanded="False">
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="服务地址:" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Margin="6,0,12,0" VerticalContentAlignment="Center"
                         Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Column="2" Text="API Key:" VerticalAlignment="Center" />
                <TextBox Grid.Column="3" Margin="6,0,0,0" VerticalContentAlignment="Center"
                         Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
        </Expander>

        <!-- 消息列表 -->
        <Border Grid.Row="2" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="6" Background="#FAFAFA">
            <ScrollViewer x:Name="MessagesScroll" VerticalScrollBarVisibility="Auto"
                          ScrollChanged="MessagesScroll_ScrollChanged">
                <ItemsControl ItemsSource="{Binding Messages}" Margin="8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ChatMessageViewModel}">
                            <Grid Margin="0,4">
                                <Border x:Name="Bubble" MaxWidth="620" Padding="12,8" CornerRadius="10"
                                        HorizontalAlignment="Left"
                                        Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock x:Name="AuthorText" Text="{Binding Author}"
                                                   FontSize="11" Foreground="#999999" Margin="0,0,0,2" />
                                        <TextBlock x:Name="ContentText" Text="{Binding Content}"
                                                   TextWrapping="Wrap" FontSize="14" LineHeight="20" />
                                        <ItemsControl ItemsSource="{Binding Images}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Image Source="{Binding Converter={StaticResource Base64ToImage}}"
                                                           MaxWidth="200" MaxHeight="200" Margin="0,4,4,0" Stretch="Uniform" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsUser}" Value="True">
                                    <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right" />
                                    <Setter TargetName="Bubble" Property="Background" Value="#4C8BF5" />
                                    <Setter TargetName="Bubble" Property="BorderBrush" Value="#4C8BF5" />
                                    <Setter TargetName="AuthorText" Property="Foreground" Value="#D8E6FF" />
                                    <Setter TargetName="ContentText" Property="Foreground" Value="White" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- 状态栏 -->
        <TextBlock Grid.Row="3" Text="{Binding StatusText}" FontSize="11" Foreground="#888888"
                   Margin="2,4,2,4" TextTrimming="CharacterEllipsis" />

        <!-- 输入区 -->
        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 待发送图片预览 -->
            <ItemsControl Grid.Row="0" ItemsSource="{Binding PendingImageDataUrls}"
                          HorizontalAlignment="Left">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,4,4" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4"
                                Background="#F4F4F4" ToolTip="点击移除">
                            <Grid>
                                <Image Source="{Binding Converter={StaticResource Base64ToImage}}"
                                       MaxWidth="80" MaxHeight="80" Stretch="Uniform" />
                                <Button Content="✕" Width="20" Height="20" Padding="0"
                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Command="{Binding DataContext.RemovePendingImageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Grid.Row="1" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="🖼 图片" Click="AttachImages_Click"
                        Padding="10,0" Margin="0,0,8,0" VerticalAlignment="Stretch" />

                <TextBox x:Name="InputBox" Grid.Column="1"
                         Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="56" MaxHeight="160" Padding="8"
                         VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top"
                         PreviewKeyDown="InputBox_PreviewKeyDown" />

                <Button Grid.Column="2" Content="发送" Command="{Binding SendCommand}"
                        Width="76" Margin="8,0,0,0" VerticalAlignment="Stretch" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
