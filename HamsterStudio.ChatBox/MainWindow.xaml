<Window x:Class="HamsterStudio.ChatBox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HamsterStudio.ChatBox"
        xmlns:localv="clr-namespace:HamsterStudio.ChatBox.Views"
        mc:Ignorable="d"
        Title="ChatBox" Height="720" Width="1000">
    <Window.DataContext>
        <local:MainWindowModel />
    </Window.DataContext>
    <localv:ChatBoxMainView DataContext="{Binding MainViewModel}" />
</Window>
