<UserControl x:Class="HamsterStudio.Photogrammetry.Views.ReferenceProjectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:behaviors="clr-namespace:HamsterStudio.Photogrammetry.Behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="450"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <Grid>
        <hc:Interaction.Behaviors>
            <behaviors:ReferenceProjectDropBehavior />
        </hc:Interaction.Behaviors>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="480" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧：项目信息与参考图列表 -->
        <DockPanel Grid.Column="0">
            <StackPanel DockPanel.Dock="Top" Margin="10">
                <TextBlock FontWeight="SemiBold" Text="项目名称" />
                <TextBox Margin="0,2,0,10"
                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock FontWeight="SemiBold" Text="项目描述" />
                <TextBox Height="48"
                         Margin="0,2,0,10"
                         AcceptsReturn="True"
                         Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                         TextWrapping="Wrap" />

                <TextBlock FontWeight="SemiBold" Text="场景" />
                <Grid Margin="0,2,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding NewSceneName, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="1"
                            Margin="6,0,0,0"
                            Command="{Binding AddSceneCommand}"
                            Content="添加场景" />
                </Grid>
                <ItemsControl Margin="0,0,0,8" ItemsSource="{Binding Scenes}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,4,4"
                                    Padding="6,2"
                                    Background="#f0f0f0"
                                    CornerRadius="3">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock VerticalAlignment="Center" Text="{Binding}" />
                                    <Button Margin="4,0,0,0"
                                            Padding="4,0"
                                            Command="{Binding DataContext.RemoveSceneCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Content="×" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <hc:SearchBar Grid.Column="0"
                                  hc:InfoElement.Placeholder="按文件名搜索"
                                  Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <ComboBox Grid.Column="1"
                              Width="72"
                              Margin="8,0,0,0"
                              ToolTip="按需求程度筛选"
                              SelectedIndex="{Binding DemandFilterIndex}">
                        <ComboBoxItem Content="全部" />
                        <ComboBoxItem Content="普通" />
                        <ComboBoxItem Content="必须" />
                    </ComboBox>
                    <ComboBox Grid.Column="2"
                              Width="72"
                              Margin="8,0,0,0"
                              ToolTip="按拍摄状态筛选"
                              SelectedIndex="{Binding ShotFilterIndex}">
                        <ComboBoxItem Content="全部" />
                        <ComboBoxItem Content="未拍摄" />
                        <ComboBoxItem Content="已拍摄" />
                    </ComboBox>
                    <ComboBox Grid.Column="3"
                              Width="88"
                              Margin="8,0,0,0"
                              ToolTip="按场景筛选"
                              ItemsSource="{Binding SceneFilterOptions}"
                              SelectedItem="{Binding SelectedSceneFilter}" />
                </Grid>

                <WrapPanel>
                    <Button Margin="0,0,6,4" Command="{Binding NewProjectCommand}" Content="新建项目" />
                    <Button Margin="0,0,6,4" Command="{Binding AddReferencesCommand}" Content="添加参考图" />
                    <Button Margin="0,0,6,4" Command="{Binding ClearCommand}" Content="清空" />
                    <Button Margin="0,0,6,4" Command="{Binding LoadCommand}" Content="打开项目" />
                    <Button Margin="0,0,6,4" Command="{Binding SaveCommand}" Content="保存项目" />
                </WrapPanel>
            </StackPanel>

            <ListBox x:Name="ReferenceList"
                     ItemsSource="{Binding FilteredReferences}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectedItem="{Binding SelectedReference}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="4"
                                Padding="6"
                                BorderBrush="#dcdcdc"
                                BorderThickness="1"
                                CornerRadius="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Image Grid.Column="0"
                                       Width="80"
                                       Height="56"
                                       Source="{Binding Thumbnail}"
                                       Stretch="Uniform" />

                                <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                                    <TextBlock FontWeight="SemiBold"
                                               Text="{Binding FileName}"
                                               TextTrimming="CharacterEllipsis" />
                                    <ComboBox Width="80"
                                              Margin="0,6,0,0"
                                              HorizontalAlignment="Left"
                                              SelectedIndex="{Binding DemandDegreeIndex}">
                                        <ComboBoxItem Content="普通" />
                                        <ComboBoxItem Content="必须" />
                                    </ComboBox>
                                    <CheckBox Margin="0,6,0,0"
                                              Content="已拍摄"
                                              IsChecked="{Binding IsShot}" />
                                    <hc:CheckComboBox Width="130"
                                                      Margin="0,6,0,0"
                                                      HorizontalAlignment="Left"
                                                      Style="{StaticResource CheckComboBoxExtend}"
                                                      hc:InfoElement.Placeholder="选择场景"
                                                      ItemsSource="{Binding DataContext.Scenes, ElementName=ReferenceList}"
                                                      hc:ListBoxAttach.SelectedItems="{Binding SelectedScenes, Mode=TwoWay}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <StackPanel Margin="0,0,0,6" HorizontalAlignment="Center" Orientation="Horizontal">
                                        <Button Width="30"
                                                Margin="0,0,2,0"
                                                Padding="0"
                                                ToolTip="上移"
                                                Command="{Binding DataContext.MoveUpCommand, ElementName=ReferenceList}"
                                                CommandParameter="{Binding}"
                                                Content="↑" />
                                        <Button Width="30"
                                                Margin="0,0,2,0"
                                                Padding="0"
                                                ToolTip="下移"
                                                Command="{Binding DataContext.MoveDownCommand, ElementName=ReferenceList}"
                                                CommandParameter="{Binding}"
                                                Content="↓" />
                                        <Button Padding="6,0"
                                                ToolTip="放首位"
                                                Command="{Binding DataContext.MoveToFirstCommand, ElementName=ReferenceList}"
                                                CommandParameter="{Binding}"
                                                Content="置顶" />
                                    </StackPanel>
                                    <Button Margin="0,0,0,4"
                                            Padding="8,2"
                                            Command="{Binding DataContext.ShowFullscreenCommand, ElementName=ReferenceList}"
                                            CommandParameter="{Binding}"
                                            Content="最大化" />
                                    <Button Margin="0,0,0,4"
                                            Padding="8,2"
                                            Command="{Binding DataContext.OpenWithSystemCommand, ElementName=ReferenceList}"
                                            CommandParameter="{Binding}"
                                            Content="系统打开" />
                                    <Button Padding="8,2"
                                            Command="{Binding DataContext.RemoveReferenceCommand, ElementName=ReferenceList}"
                                            CommandParameter="{Binding}"
                                            Content="移除" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- 右侧：图片查看器（滚轮缩放、拖拽平移、工具栏缩放） -->
        <Grid Grid.Column="1" Background="#ff1e1e1e">
            <hc:ImageViewer x:Name="Viewer"
                            Background="#ff1e1e1e"
                            ShowToolBar="True"
                            Uri="{Binding SelectedReference.ImageUri}" />

            <Button Margin="8"
                    Padding="10,4"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Click="ResetViewer_Click"
                    Content="还原" />

            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="#88ffffff"
                       IsHitTestVisible="False"
                       Text="选择左侧参考图以查看，滚轮缩放、拖拽平移">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedReference}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </Grid>
</UserControl>
