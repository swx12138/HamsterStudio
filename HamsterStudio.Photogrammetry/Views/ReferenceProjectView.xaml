<UserControl x:Class="HamsterStudio.Photogrammetry.Views.ReferenceProjectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="450"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" MinWidth="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧：项目信息与参考图列表 -->
        <DockPanel Grid.Column="0">
            <StackPanel DockPanel.Dock="Top" Margin="10">
                <TextBlock FontWeight="SemiBold" Text="项目名称" />
                <TextBox Margin="0,2,0,10"
                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock FontWeight="SemiBold" Text="项目描述" />
                <TextBox Height="48"
                         Margin="0,2,0,10"
                         AcceptsReturn="True"
                         Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                         TextWrapping="Wrap" />

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <hc:SearchBar Grid.Column="0"
                                  hc:InfoElement.Placeholder="按文件名搜索"
                                  Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <ComboBox Grid.Column="1"
                              Width="72"
                              Margin="8,0,0,0"
                              SelectedIndex="{Binding DemandFilterIndex}">
                        <ComboBoxItem Content="全部" />
                        <ComboBoxItem Content="普通" />
                        <ComboBoxItem Content="必须" />
                    </ComboBox>
                </Grid>

                <StackPanel Orientation="Horizontal">
                    <Button Margin="0,0,6,0" Command="{Binding AddReferencesCommand}" Content="添加参考图" />
                    <Button Margin="0,0,6,0" Command="{Binding ClearCommand}" Content="清空" />
                    <Button Margin="0,0,6,0" Command="{Binding LoadCommand}" Content="打开项目" />
                    <Button Command="{Binding SaveCommand}" Content="保存项目" />
                </StackPanel>
            </StackPanel>

            <ListBox x:Name="ReferenceList"
                     ItemsSource="{Binding FilteredReferences}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectedItem="{Binding SelectedReference}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="4"
                                Padding="6"
                                BorderBrush="#dcdcdc"
                                BorderThickness="1"
                                CornerRadius="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Image Grid.Column="0"
                                       Width="80"
                                       Height="56"
                                       Source="{Binding Thumbnail}"
                                       Stretch="Uniform" />

                                <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                                    <TextBlock FontWeight="SemiBold"
                                               Text="{Binding FileName}"
                                               TextTrimming="CharacterEllipsis" />
                                    <ComboBox Width="80"
                                              Margin="0,6,0,0"
                                              HorizontalAlignment="Left"
                                              SelectedIndex="{Binding DemandDegreeIndex}">
                                        <ComboBoxItem Content="普通" />
                                        <ComboBoxItem Content="必须" />
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <Button Margin="0,0,0,4"
                                            Padding="8,2"
                                            Command="{Binding DataContext.ShowFullscreenCommand, ElementName=ReferenceList}"
                                            CommandParameter="{Binding}"
                                            Content="最大化" />
                                    <Button Margin="0,0,0,4"
                                            Padding="8,2"
                                            Command="{Binding DataContext.OpenWithSystemCommand, ElementName=ReferenceList}"
                                            CommandParameter="{Binding}"
                                            Content="系统打开" />
                                    <Button Padding="8,2"
                                            Command="{Binding DataContext.RemoveReferenceCommand, ElementName=ReferenceList}"
                                            CommandParameter="{Binding}"
                                            Content="移除" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- 右侧：图片查看器（滚轮缩放、拖拽平移、工具栏缩放） -->
        <Grid Grid.Column="1" Background="#ff1e1e1e">
            <hc:ImageViewer Background="#ff1e1e1e"
                            ShowToolBar="True"
                            Uri="{Binding SelectedReference.ImageUri}" />

            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="#88ffffff"
                       IsHitTestVisible="False"
                       Text="选择左侧参考图以查看，滚轮缩放、拖拽平移">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedReference}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </Grid>
</UserControl>
